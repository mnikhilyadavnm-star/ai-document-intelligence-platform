# Copy to .env and fill in your own values. Do not commit real keys.
# No API key is required to run locally — LLM_* are optional.

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_docs
REDIS_URL=redis://localhost:6379/0

# Optional: only if you want LLM-generated answers instead of the
# default extractive (passage-based) answers. Leave empty to use
# the free local TF-IDF + extractive RAG only.
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
